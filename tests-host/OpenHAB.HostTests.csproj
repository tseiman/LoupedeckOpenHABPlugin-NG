<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <PluginApiDir Condition="'$(PluginApiDir)' == '' and '$(OPENHAB_PLUGIN_SDK_DIR)' != ''">$(OPENHAB_PLUGIN_SDK_DIR)</PluginApiDir>
    <PluginApiDir Condition="'$(PluginApiDir)' == '' and '$(OS)' == 'Windows_NT'">C:/Program Files/Logi/LogiPluginService/</PluginApiDir>
    <PluginApiDir Condition="'$(PluginApiDir)' == ''">/Applications/Utilities/LogiPluginService.app/Contents/MonoBundle/</PluginApiDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../OpenHABPlugin/OpenHABPlugin.csproj" />
    <Reference Include="PluginApi"><HintPath>$(PluginApiDir)/PluginApi.dll</HintPath></Reference>
  </ItemGroup>
</Project>
