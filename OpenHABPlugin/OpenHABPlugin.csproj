<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Loupedeck.OpenHABPluginNG</RootNamespace>
    <AssemblyName>OpenHABPluginNG</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <PluginPlatform Condition="'$(OS)' == 'Windows_NT'">win</PluginPlatform>
    <PluginPlatform Condition="'$(PluginPlatform)' == ''">mac</PluginPlatform>
    <PluginBuildRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../bin/$(Configuration)'))</PluginBuildRoot>
    <OutputPath>$(PluginBuildRoot)/$(PluginPlatform)/</OutputPath>
    <PluginApiDir Condition="'$(PluginApiDir)' == '' and '$(OPENHAB_PLUGIN_SDK_DIR)' != ''">$(OPENHAB_PLUGIN_SDK_DIR)</PluginApiDir>
    <PluginApiDir Condition="'$(PluginApiDir)' == '' and '$(OS)' == 'Windows_NT'">C:/Program Files/Logi/LogiPluginService/</PluginApiDir>
    <PluginApiDir Condition="'$(PluginApiDir)' == ''">/Applications/Utilities/LogiPluginService.app/Contents/MonoBundle/</PluginApiDir>
    <InstallPluginLink Condition="'$(InstallPluginLink)' == ''">false</InstallPluginLink>
    <PluginDir Condition="'$(PluginDir)' == '' and '$(OS)' == 'Windows_NT'">$(LOCALAPPDATA)/Logi/LogiPluginService/Plugins</PluginDir>
    <PluginDir Condition="'$(PluginDir)' == ''">$(HOME)/Library/Application Support/Logi/LogiPluginService/Plugins</PluginDir>
    <PluginLinkFile>$(PluginDir)/OpenHABNG.link</PluginLinkFile>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="PluginApi">
      <HintPath>$(PluginApiDir)/PluginApi.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <EmbeddedResource Include="Resources/*.png" />
    <EmbeddedResource Include="Resources/F7/*.svg" />
    <None Include="../licenses/*" Link="licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="VerifyPluginApi" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(PluginApiDir)/PluginApi.dll')" Text="PluginApi.dll missing from the host installation. Install Logi Plugin Service, set OPENHAB_PLUGIN_SDK_DIR, or pass /p:PluginApiDir=/path/to/sdk. This project targets .NET 10." />
    <Message Importance="High" Text="OpenHAB NG host SDK: $(PluginApiDir)" />
  </Target>
  <Target Name="CopyMetadata" AfterTargets="Build">
    <ItemGroup>
      <MetadataFiles Include="$(MSBuildProjectDirectory)/metadata/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(MetadataFiles)" DestinationFiles="@(MetadataFiles->'$(OutputPath)../metadata/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="RemoveLegacyBuildArtifacts" BeforeTargets="PrepareForBuild">
    <Delete Files="$(OutputPath)OpenHABPlugin.dll;$(OutputPath)OpenHABPlugin.pdb;$(OutputPath)OpenHABPlugin.deps.json;$(OutputPath)OpenHABPlugin.dll.config" />
  </Target>
  <Target Name="InstallOpenHABPluginLink" AfterTargets="CopyMetadata" Condition="'$(InstallPluginLink)' == 'true'">
    <MakeDir Directories="$(PluginDir)" />
    <WriteLinesToFile File="$(PluginLinkFile)" Lines="$(PluginBuildRoot)" Overwrite="true" Encoding="UTF-8" WriteOnlyWhenDifferent="true" />
    <Message Importance="High" Text="Registered OpenHAB NG: $(PluginLinkFile)" />
  </Target>
  <Target Name="CleanOpenHABPluginLayout" AfterTargets="CoreClean">
    <RemoveDir Directories="$(PluginBuildRoot)/metadata" />
  </Target>
  <Target Name="CleanOpenHABPluginLink" AfterTargets="CoreClean" Condition="'$(InstallPluginLink)' == 'true' and Exists('$(PluginLinkFile)')">
    <ReadLinesFromFile File="$(PluginLinkFile)">
      <Output TaskParameter="Lines" ItemName="OpenHABPluginLinkLines" />
    </ReadLinesFromFile>
    <Delete Files="$(PluginLinkFile)" Condition="'@(OpenHABPluginLinkLines)' == '$(PluginBuildRoot)'" />
  </Target>
</Project>
