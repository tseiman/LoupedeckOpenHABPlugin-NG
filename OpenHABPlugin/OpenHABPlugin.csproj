<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Loupedeck.OpenHABPluginNG</RootNamespace>
    <AssemblyName>OpenHABPluginNG</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <PluginPlatform Condition="'$(OS)' == 'Windows_NT'">win</PluginPlatform>
    <PluginPlatform Condition="'$(PluginPlatform)' == ''">mac</PluginPlatform>
    <OutputPath>$(MSBuildProjectDirectory)/../bin/$(Configuration)/$(PluginPlatform)/</OutputPath>
    <PluginApiDir Condition="'$(PluginApiDir)' == '' and '$(OS)' == 'Windows_NT'">C:/Program Files/Logi/LogiPluginService/</PluginApiDir>
    <PluginApiDir Condition="'$(PluginApiDir)' == ''">/Applications/Utilities/LogiPluginService.app/Contents/MonoBundle/</PluginApiDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="PluginApi">
      <HintPath>$(PluginApiDir)/PluginApi.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <EmbeddedResource Include="Resources/*.png" />
    <EmbeddedResource Include="Resources/F7/*.svg" />
    <None Include="../licenses/*" Link="licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="VerifyPluginApi" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(PluginApiDir)/PluginApi.dll')" Text="PluginApi.dll missing. Set /p:PluginApiDir=/path/to/a/net8-compatible/sdk." />
  </Target>
  <Target Name="CopyMetadata" AfterTargets="Build">
    <ItemGroup>
      <MetadataFiles Include="$(MSBuildProjectDirectory)/metadata/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(MetadataFiles)" DestinationFiles="@(MetadataFiles->'$(OutputPath)../metadata/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="RemoveLegacyBuildArtifacts" BeforeTargets="PrepareForBuild">
    <Delete Files="$(OutputPath)OpenHABPlugin.dll;$(OutputPath)OpenHABPlugin.pdb;$(OutputPath)OpenHABPlugin.deps.json;$(OutputPath)OpenHABPlugin.dll.config" />
  </Target>
</Project>
