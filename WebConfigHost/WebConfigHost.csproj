<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>OpenHABPluginNG.WebConfig</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../external/LoupedeckWebConfigLib/LoupedeckWebConfigLib/*.cs" />
    <EmbeddedResource Include="../external/LoupedeckWebConfigLib/LoupedeckWebConfigLib/wwwroot/**/*">
      <LogicalName>wwwroot/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <Content Include="../external/LoupedeckWebConfigLib/LoupedeckWebConfigLib/wwwroot/**/*" Link="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../external/LoupedeckWebConfigLib/LICENSE" Link="licenses/LoupedeckWebConfigLib-LICENSE" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="VerifyWebConfigSources" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('../external/LoupedeckWebConfigLib/LoupedeckWebConfigLib/LoupedeckWebConfigService.cs')" Text="WebConfig dependency missing. Run git submodule update --init --recursive." />
  </Target>
</Project>
